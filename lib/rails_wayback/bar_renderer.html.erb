<link rel="stylesheet" href="<%= escape(stylesheet_url) %>" data-rails-wayback<%= nonce_attribute %>>
<div id="rails-wayback-bar" data-mount="<%= escape(@engine_mount) %>"
     data-branch="<%= escape(@current_branch) %>"
     data-commit="<%= escape(@current_commit) %>"
     data-active-ref="<%= escape(@active_ref.to_s) %>"
     data-active-branch="<%= escape(@active_branch.to_s) %>"
     data-ref-error="<%= escape(@ref_error) %>"
     data-preview-mode="<%= escape(@diff_info&.dig(:preview_mode).to_s) %>">
  <div class="rw-bar-inner">
    <div class="rw-field">
      <label for="rails-wayback-branches"><%= escape(branch_label) %></label>
      <div class="rw-selector">
        <input type="search" data-rw-branch-search aria-label="Search Git refs"
               aria-controls="rails-wayback-branches" placeholder="Search refs"
               autocomplete="off" spellcheck="false" disabled>
        <select id="rails-wayback-branches" data-rw-branch aria-label="Git ref" disabled></select>
      </div>
      <span class="rw-search-status" data-rw-branch-results role="status" aria-live="polite"></span>
    </div>
    <div class="rw-field rw-flex">
      <label for="rails-wayback-commits"><%= escape(commit_label) %></label>
      <div class="rw-selector">
        <input type="search" data-rw-commit-search aria-label="Search commits"
               aria-controls="rails-wayback-commits" placeholder="Search commits"
               autocomplete="off" spellcheck="false" disabled>
        <select id="rails-wayback-commits" data-rw-commit aria-label="Git commit" disabled></select>
      </div>
      <span class="rw-search-status" data-rw-commit-results role="status" aria-live="polite"></span>
    </div>
    <div class="rw-state" data-rw-state></div>
    <button type="button" data-rw-travel class="rw-btn rw-btn-primary">Travel</button>
    <button type="button" data-rw-reset class="rw-btn rw-btn-ghost" hidden>Return to HEAD</button>
  </div>
  <div class="rw-trust-notice" data-rw-trust-notice>
    Historical templates execute Ruby in this process. Only travel to commits you trust.
    Historical JavaScript executes in this application's browser origin.
    <% unless @ref_error.empty? %>
      <strong class="rw-ref-rejected"><%= escape(@ref_error) %></strong>
    <% end %>
  </div>
  <%= diff_summary_html %>
</div>
<script src="<%= escape(javascript_url) %>" defer data-rails-wayback<%= nonce_attribute %>></script>

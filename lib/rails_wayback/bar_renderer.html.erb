<link rel="stylesheet" href="<%= escape(stylesheet_url) %>" data-rails-wayback<%= nonce_attribute %>>
<div id="rails-wayback-bar" data-mount="<%= escape(@engine_mount) %>"
     data-branch="<%= escape(@current_branch) %>"
     data-commit="<%= escape(@current_commit) %>"
     data-active-ref="<%= escape(@active_ref.to_s) %>"
     data-active-branch="<%= escape(@active_branch.to_s) %>"
     data-ref-error="<%= escape(@ref_error) %>"
     data-preview-mode="<%= escape(@diff_info&.dig(:preview_mode).to_s) %>">
  <div class="rw-bar-inner">
    <div class="rw-field">
      <label id="rails-wayback-branches-label" for="rails-wayback-branch-trigger"><%= escape(branch_label) %></label>
      <div class="rw-combobox" data-rw-branch-combobox>
        <button id="rails-wayback-branch-trigger" type="button" class="rw-combobox-trigger"
                data-rw-branch-trigger aria-haspopup="listbox" aria-expanded="false"
                aria-labelledby="rails-wayback-branches-label rails-wayback-branch-value"
                aria-controls="rails-wayback-branches" disabled>
          <span id="rails-wayback-branch-value" data-rw-branch-value>Loading refs…</span>
        </button>
        <div class="rw-combobox-dropdown" data-rw-branch-dropdown hidden>
          <input type="search" data-rw-branch-search aria-label="Search Git refs"
                 role="combobox" aria-autocomplete="list" aria-expanded="false"
                 aria-controls="rails-wayback-branches" placeholder="Search refs"
                 autocomplete="off" spellcheck="false" disabled>
          <div id="rails-wayback-branches" data-rw-branch-options role="listbox"
               aria-labelledby="rails-wayback-branches-label" class="rw-combobox-options"></div>
          <span class="rw-search-status" data-rw-branch-results role="status" aria-live="polite"></span>
        </div>
      </div>
    </div>
    <div class="rw-field rw-flex">
      <label id="rails-wayback-commits-label" for="rails-wayback-commit-trigger"><%= escape(commit_label) %></label>
      <div class="rw-combobox rw-combobox-commit" data-rw-commit-combobox>
        <button id="rails-wayback-commit-trigger" type="button" class="rw-combobox-trigger"
                data-rw-commit-trigger aria-haspopup="listbox" aria-expanded="false"
                aria-labelledby="rails-wayback-commits-label rails-wayback-commit-value"
                aria-controls="rails-wayback-commits" disabled>
          <span id="rails-wayback-commit-value" data-rw-commit-value>Loading commits…</span>
        </button>
        <div class="rw-combobox-dropdown" data-rw-commit-dropdown hidden>
          <input type="search" data-rw-commit-search aria-label="Search commits"
                 role="combobox" aria-autocomplete="list" aria-expanded="false"
                 aria-controls="rails-wayback-commits" placeholder="Search commits"
                 autocomplete="off" spellcheck="false" disabled>
          <div id="rails-wayback-commits" data-rw-commit-options role="listbox"
               aria-labelledby="rails-wayback-commits-label" class="rw-combobox-options"></div>
          <span class="rw-search-status" data-rw-commit-results role="status" aria-live="polite"></span>
        </div>
      </div>
    </div>
    <div class="rw-state" data-rw-state></div>
    <button type="button" data-rw-travel class="rw-btn rw-btn-primary">Travel</button>
    <button type="button" data-rw-reset class="rw-btn rw-btn-ghost" hidden>Return to HEAD</button>
  </div>
  <div class="rw-trust-notice" data-rw-trust-notice>
    Historical templates execute Ruby in this process. Only travel to commits you trust.
    Historical JavaScript executes in this application's browser origin.
    <% unless @ref_error.empty? %>
      <strong class="rw-ref-rejected"><%= escape(@ref_error) %></strong>
    <% end %>
  </div>
  <%= diff_summary_html %>
</div>
<script src="<%= escape(javascript_url) %>" defer data-rails-wayback<%= nonce_attribute %>></script>
